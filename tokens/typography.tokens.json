{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "typography": {
    "$description": "Font families, weights, line heights, tracking and text styles. Text styles → Figma text styles (name in $extensions); the rest is code-only.",
    "font": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Suisse BP Intl",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "label": {
        "$value": [
          "KH Interference",
          "ui-monospace",
          "SFMono-Regular",
          "monospace"
        ],
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "serif": {
        "$value": [
          "Suisse BP Serif",
          "Georgia",
          "Times New Roman",
          "serif"
        ],
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "neue": {
        "$value": [
          "Suisse BP Neue",
          "Suisse BP Serif",
          "Georgia",
          "serif"
        ],
        "$description": "A serif, despite the deck README.",
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "antique": {
        "$value": [
          "Suisse BP Intl Antique",
          "Suisse BP Intl",
          "sans-serif"
        ],
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      }
    },
    "font-family": {
      "$type": "fontFamily",
      "display": {
        "$value": "{typography.font.display}",
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "label": {
        "$value": "{typography.font.label}",
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "serif": {
