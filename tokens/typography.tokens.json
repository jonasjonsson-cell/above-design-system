          }
        }
      },
      "base": {
        "$value": "{typography.font.display}",
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      }
    },
    "font-weight": {
      "$type": "fontWeight",
      "thin": {
        "$value": 100,
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "ultralight": {
        "$value": 200,
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "light": {
        "$value": 300,
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "regular": {
        "$value": 400,
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "medium": {
        "$value": 500,
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "bold": {
        "$value": 700,
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "black": {
        "$value": 900,
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      }
    },
    "line": {
      "display": {
        "$type": "number",
        "$value": 0.8,
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      }
    },
    "line-height": {
      "$type": "number",
      "display": {
        "$value": "{typography.line.display}",
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "tight": {
        "$value": 1.1,
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      },
      "base": {
        "$value": 1.4,
        "$extensions": {
          "se.above": {
            "codeOnly": true
          }
        }
      }
    },
    "tracking": {
      "$description": "Relative letter-spacing, emitted in em (DTCG has no em unit, so these are numbers with cssUnit em).",
      "cover": {
        "$type": "number",
        "$value": -0.04,
        "$extensions": {
          "se.above": {
            "codeOnly": true,
            "cssUnit": "em"
          }
        }
      },
      "tight": {
        "$type": "number",
        "$value": -0.05,
        "$extensions": {
          "se.above": {
            "codeOnly": true,
            "cssUnit": "em"
          }
        }
      },
      "tighter": {
        "$type": "number",
        "$value": -0.08,
        "$extensions": {
          "se.above": {
            "codeOnly": true,
            "cssUnit": "em"
          }
        }
      },
      "label": {
        "$type": "number",
        "$value": 0.06,
        "$extensions": {
          "se.above": {
            "codeOnly": true,
            "cssUnit": "em"
          }
        }
      },
      "label-text": {
        "$type": "number",
        "$value": 0.06,
        "$extensions": {
          "se.above": {
            "codeOnly": true,
            "cssUnit": "em"
          }
        }
      },
      "display": {
        "$type": "number",
        "$value": "{typography.tracking.tight}",
        "$extensions": {
          "se.above": {
            "codeOnly": true,
            "cssUnit": "em"
          }
        }
      },
      "mega": {
        "$type": "number",
        "$value": "{typography.tracking.tighter}",
        "$extensions": {
          "se.above": {
            "codeOnly": true,
            "cssUnit": "em"
          }
        }
      }
    },
    "text": {
      "$type": "typography",
      "$description": "Text styles. CSS: --text-<name> (font shorthand), --tracking-<name>, class .text-<name>. letterSpacing is px (DTCG); CSS emits it as em.",
      "display-l": {
        "$value": {
          "fontFamily": "{typography.font.display}",
          "fontSize": {
            "value": 220,
            "unit": "px"
          },
          "fontWeight": 400,
          "lineHeight": 0.75,
          "letterSpacing": {
            "value": -13.2,
            "unit": "px"
          }
