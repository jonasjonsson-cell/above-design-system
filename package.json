{
  "name": "above-design-system",
  "private": true,
  "version": "0.2.0",
  "license": "UNLICENSED",
  "type": "module",
  "description": "Above design system — React + TypeScript component library documented in Storybook, with a companion Figma library.",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "chromatic": "chromatic",
    "ci": "npm run tokens:check && npm run typecheck && npm run chromatic",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "chromatic": "^18.9.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
